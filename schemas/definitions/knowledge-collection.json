{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/knowledge-collection.json",
  "title": "KnowledgeCollection",
  "type": "object",
  "properties": {
    "kind": {
      "const": "KnowledgeCollection"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "pinned_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "common.json#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "curated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "method",
              "historical_report",
              "handoff"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "kind",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "version",
    "source_root",
    "pinned_files",
    "curated"
  ],
  "additionalProperties": false
}
