{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/source.json",
  "title": "SourceDocument 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "SourceDocument"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/provenance"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/issue"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/sha256"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "requirements",
        "hardware_specification",
        "benchmark_report",
        "project_record",
        "design",
        "machine_inventory",
        "model_metadata",
        "calibration"
      ]
    },
    "authority": {
      "enum": [
        "user_supplied",
        "machine_collected"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete_visible",
            "partial",
            "reference_only"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "provenance",
    "issues",
    "extensions",
    "path",
    "sha256",
    "media_type",
    "role",
    "authority",
    "coverage"
  ],
  "additionalProperties": false
}
