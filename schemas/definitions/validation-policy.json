{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/validation-policy.json",
  "title": "ValidationPolicy 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "ValidationPolicy"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/provenance"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/issue"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "purpose": {
      "enum": [
        "correctness",
        "quality"
      ]
    },
    "evaluator_sha256": {
      "anyOf": [
        {
          "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_sha256": {
      "anyOf": [
        {
          "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_sha256": {
      "anyOf": [
        {
          "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "lt",
              "le",
              "gt",
              "ge",
              "eq"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "metric",
          "operator",
          "threshold",
          "unit",
          "aggregation"
        ],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "command",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "provenance",
    "issues",
    "extensions",
    "purpose",
    "evaluator_sha256",
    "dataset_sha256",
    "reference_sha256",
    "checks",
    "execution"
  ],
  "additionalProperties": false
}
