{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/trace-capture.json",
  "title": "TraceCapture 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "TraceCapture"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/provenance"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/issue"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "evidence_kind": {
      "enum": [
        "measured",
        "synthetic"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "time_unit": {
      "const": "ns"
    },
    "profiled_run": {
      "const": true
    },
    "overhead_ratio": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clock_domain": {
            "type": "string",
            "minLength": 1
          },
          "start_ns": {
            "type": "number",
            "minimum": 0
          },
          "end_ns": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "clock_domain",
          "start_ns",
          "end_ns"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "clock_domain": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "stream": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start_ns": {
            "type": "number",
            "minimum": 0
          },
          "duration_ns": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "clock_domain",
          "rank",
          "stream",
          "category",
          "name",
          "start_ns",
          "duration_ns"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "provenance",
    "issues",
    "extensions",
    "evidence_kind",
    "run_id",
    "tool",
    "time_unit",
    "profiled_run",
    "overhead_ratio",
    "windows",
    "events"
  ],
  "additionalProperties": false
}
