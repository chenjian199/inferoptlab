{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/benchmark.json",
  "title": "BenchmarkPlan 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "BenchmarkPlan"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/provenance"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/issue"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "study_ref": {
      "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/reference"
    },
    "scenario_refs": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/reference"
      },
      "minItems": 1
    },
    "deployment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/reference"
      },
      "minItems": 1
    },
    "mode": {
      "enum": [
        "exploratory",
        "formal"
      ]
    },
    "aiperf": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.12.0"
        },
        "server_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "gpu_telemetry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "required_telemetry": {
          "enum": [
            "none",
            "server",
            "gpu",
            "both"
          ]
        }
      },
      "required": [
        "version",
        "server_metrics",
        "gpu_telemetry",
        "required_telemetry"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_runs",
        "max_wall_seconds",
        "run_timeout_s"
      ],
      "additionalProperties": false
    },
    "order_seed": {
      "type": "integer",
      "minimum": 0
    },
    "failure_policy": {
      "enum": [
        "continue",
        "stop"
      ]
    },
    "qualification_required": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "provenance",
    "issues",
    "extensions",
    "study_ref",
    "scenario_refs",
    "deployment_refs",
    "mode",
    "aiperf",
    "budget",
    "order_seed",
    "failure_policy"
  ],
  "additionalProperties": false
}
