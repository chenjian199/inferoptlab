{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudySpec template 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "StudySpec"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "is_template": {
      "type": "boolean"
    },
    "model": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "quality_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "revision",
        "tokenizer_revision",
        "quantization",
        "quality_policy_ref"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "container_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "version",
        "source_commit",
        "container_digest"
      ],
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "inventory_ref": {
          "type": "string",
          "minLength": 1
        },
        "allocated_accelerators": {
          "type": "integer",
          "minimum": 1
        },
        "resource_accounting": {
          "const": "allocated_unique_physical_devices"
        },
        "topology_scope": {
          "type": "string",
          "minLength": 1
        },
        "auxiliary_devices_in_budget": {
          "const": true
        }
      },
      "required": [
        "inventory_ref",
        "allocated_accelerators",
        "resource_accounting",
        "topology_scope",
        "auxiliary_devices_in_budget"
      ],
      "additionalProperties": false
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "request_set_ref": {
            "type": "string",
            "minLength": 1
          },
          "input_tokens_hint": {
            "type": "integer",
            "minimum": 1
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "arrival_mode": {
            "enum": [
              "closed_loop",
              "open_loop",
              "trace_replay"
            ]
          },
          "load_points": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 1
          },
          "cache_regime": {
            "type": "string",
            "minLength": 1
          },
          "session_policy": {
            "type": "string",
            "minLength": 1
          },
          "request_slo": {
            "type": "object",
            "properties": {
              "client_ttft_ms": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "request_tpot_ms": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "client_ttft_ms",
              "request_tpot_ms"
            ],
            "additionalProperties": false
          },
          "p95_limits": {
            "type": "object",
            "properties": {
              "client_ttft_ms": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "request_tpot_ms": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "client_ttft_ms",
              "request_tpot_ms"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "case_id",
          "request_set_ref",
          "input_tokens_hint",
          "max_output_tokens",
          "arrival_mode",
          "load_points",
          "cache_regime",
          "session_policy",
          "request_slo",
          "p95_limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "measurement": {
      "type": "object",
      "properties": {
        "protocol_ref": {
          "type": "string",
          "minLength": 1
        },
        "window_policy": {
          "type": "string",
          "minLength": 1
        },
        "sampling_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "warmup_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "request_count_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "search_repeats": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "profiling_separate_from_scoring": {
          "const": true
        },
        "retain_raw_requests": {
          "const": true
        }
      },
      "required": [
        "protocol_ref",
        "window_policy",
        "sampling_policy_ref",
        "warmup_policy_ref",
        "request_count_per_run",
        "search_repeats",
        "request_timeout_s",
        "seed",
        "profiling_separate_from_scoring",
        "retain_raw_requests"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "deployment_modes": {
          "type": "array",
          "items": {
            "enum": [
              "aggregated",
              "pd"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "parallelism_domains": {
          "type": "object",
          "properties": {
            "tp": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "dp": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "ep": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "pp": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "cp": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "tp",
            "dp",
            "ep",
            "pp",
            "cp"
          ],
          "additionalProperties": false
        },
        "tuning_domains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "minItems": 1
          }
        },
        "capability_policy": {
          "const": "probe_before_scoring"
        },
        "code_optimization_backends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "allowed_change_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "model_semantics_change_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "deployment_modes",
        "parallelism_domains",
        "tuning_domains",
        "capability_policy",
        "code_optimization_backends",
        "allowed_change_tags",
        "model_semantics_change_allowed"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "aggregate": {
          "type": "string",
          "minLength": 1
        },
        "case_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "required": [
        "metric",
        "direction",
        "aggregate",
        "case_weights"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "max_gpu_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_wall_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_agent_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_build_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_candidates",
        "max_gpu_hours",
        "max_wall_hours",
        "max_agent_tokens",
        "max_build_attempts"
      ],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "min_request_slo_attainment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_mandatory_case_regression_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_relative_improvement": {
          "type": "number",
          "minimum": 0
        },
        "final_repeats": {
          "type": "integer",
          "minimum": 1
        },
        "holdout_ref": {
          "type": "string",
          "minLength": 1
        },
        "fixed_point_and_retuned_comparisons": {
          "const": true
        }
      },
      "required": [
        "min_request_slo_attainment",
        "max_mandatory_case_regression_fraction",
        "min_relative_improvement",
        "final_repeats",
        "holdout_ref",
        "fixed_point_and_retuned_comparisons"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "on_budget_exhausted": {
          "const": true
        },
        "on_no_improvement_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "preserve_unexplained_issues": {
          "const": true
        }
      },
      "required": [
        "on_budget_exhausted",
        "on_no_improvement_rounds",
        "preserve_unexplained_issues"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "study_id",
    "is_template",
    "model",
    "engine",
    "hardware",
    "workloads",
    "measurement",
    "search",
    "objective",
    "budget",
    "acceptance",
    "stop"
  ],
  "additionalProperties": false,
  "$id": "https://inferoptlab.local/schemas/0.2.0/legacy/study-v0.1.json"
}
