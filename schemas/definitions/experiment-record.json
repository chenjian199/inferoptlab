{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/experiment-record.json",
  "title": "ExperimentRecord",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "ExperimentRecord"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "$ref": "common.json#/$defs/reference"
    },
    "hardware_ref": {
      "$ref": "common.json#/$defs/reference"
    },
    "runtime_ref": {
      "$ref": "common.json#/$defs/reference"
    },
    "deployment_ref": {
      "$ref": "common.json#/$defs/reference"
    },
    "phase": {
      "enum": [
        "prefill",
        "decode",
        "e2e",
        "local"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_state": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "recipe_snapshot": {
      "$ref": "benchmark-snapshot.json"
    },
    "run_configuration": {
      "type": "object"
    },
    "environment": {
      "type": [
        "object",
        "null"
      ]
    },
    "commands": {
      "type": [
        "object",
        "null"
      ]
    },
    "measurement": {
      "$ref": "measurement.json"
    },
    "sla": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "batch_id",
    "batch_path",
    "status",
    "model_ref",
    "hardware_ref",
    "runtime_ref",
    "deployment_ref",
    "phase",
    "method",
    "concurrency",
    "repetition",
    "snapshot_state",
    "recipe_snapshot",
    "run_configuration",
    "environment",
    "commands",
    "measurement",
    "sla",
    "artifacts",
    "content_sha256"
  ],
  "additionalProperties": false
}
