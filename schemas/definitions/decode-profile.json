{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoptlab.local/schemas/0.2.0/decode-profile.json",
  "title": "Cached Decode paired profiler diagnostic plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "DecodeProfilePlan"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/provenance"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/issue"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "deployment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/reference"
      },
      "minItems": 1
    },
    "workload_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://inferoptlab.local/schemas/0.2.0/common.json#/$defs/reference"
      }
    },
    "context_policy": {
      "const": "independent_per_concurrent_slot"
    },
    "cache_policy": {
      "const": "full_original_context_plus_one_seed"
    },
    "request_multiplier": {
      "type": "integer",
      "minimum": 1
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "request_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "point_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "title",
    "provenance",
    "issues",
    "extensions",
    "deployment_refs",
    "workload_refs",
    "context_policy",
    "cache_policy",
    "request_multiplier",
    "repetitions",
    "seed",
    "request_timeout_s",
    "point_timeout_s"
  ],
  "additionalProperties": false
}
